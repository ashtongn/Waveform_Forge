rules_version = '2';

// ============================================================================
// Waveform Forge — Firestore Security Rules (Phase 1: auth + approval)
// ----------------------------------------------------------------------------
// Security model (free/Spark plan — no Cloud Functions, no custom claims):
//
//   - Each signed-in user has a /profiles/{uid} document:
//       { email, role: 'member'|'admin', status: 'pending'|'approved'|'denied',
//         createdAt }
//   - ADMIN AUTHORITY comes from the hard-coded bootstrap UID below, or from a
//     profile whose `role` was set to 'admin' BY AN EXISTING ADMIN. Users can
//     never grant themselves a role: profile creation forces role='member', and
//     the only self-update permitted is a denied -> pending re-request that
//     touches the `status` key alone. This keeps the rules in agreement with the
//     application UI, which also treats `role == 'admin'` as admin.
//   - A user may create ONLY their own profile, and only as a pending member.
//   - A user may NOT approve themselves or change their own role.
//   - A denied user may move their OWN status back to 'pending' (re-request).
//   - Future member collections require isApproved(); admin-only ops require
//     isAdmin().
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Admin bootstrap ---------------------------------------------------
    // Replace the placeholder with YOUR Firebase Auth UID. Until you do, no
    // account has admin power and the approval queue cannot be used.
    function adminUid() {
      return 'Ni6g9PNFC2Yiejz7e8NR2P0kpBA3';
    }

    // ---- Helpers -----------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function profileRef() {
      return /databases/$(database)/documents/profiles/$(request.auth.uid);
    }

    // Guards every profile lookup. Without it, a signed-in user who has no
    // profile document yet (the moment between sign-up and the profile write)
    // makes get() return null, and the null dereference fails the WHOLE rule
    // expression rather than simply evaluating to false.
    function hasProfile() {
      return isSignedIn() && exists(profileRef());
    }

    function myProfile() {
      return get(profileRef()).data;
    }

    function isAdmin() {
      return isSignedIn()
        && (
          request.auth.uid == adminUid()
          || (hasProfile() && myProfile().role == 'admin')
        );
    }

    function isApproved() {
      return hasProfile() && myProfile().status == 'approved';
    }

    // ---- profiles ----------------------------------------------------------
    match /profiles/{uid} {
      // A user may read their own profile; the admin may read all profiles
      // (needed for the approval queue). Approved members may also read the
      // profile list so member-facing features (e.g. the Kanban assignee
      // picker) can offer a roster of teammates.
      allow read: if isAdmin()
        || isApproved()
        || (isSignedIn() && request.auth.uid == uid);

      // A user may create ONLY their own profile, and only as a pending member
      // with an email matching their auth token. This prevents self-approval
      // or self-promotion to admin at sign-up.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'member'
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(
             ['email', 'role', 'status', 'createdAt']
           );

      // The admin may change anything (approve / deny / adjust role).
      // Otherwise, a denied user may move ONLY their own status from 'denied'
      // back to 'pending' (re-request), touching no other field.
      allow update: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == uid
          && resource.data.status == 'denied'
          && request.resource.data.status == 'pending'
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['status'])
        );

      // Only the admin may delete a profile.
      allow delete: if isAdmin();
    }

    // ---- equipment ---------------------------------------------------------
    // Shared team inventory. Any approved member (or the admin) may read and
    // write; unapproved and signed-out users are denied. Records have no
    // per-user ownership — the whole team maintains one inventory.
    match /equipment/{itemId} {
      allow read, create, update, delete: if isApproved() || isAdmin();
    }

    // ---- Kanban ------------------------------------------------------------
    // Shared team task board. Any approved member (or the admin) may read and
    // write; unapproved and signed-out users are denied. Tasks have no
    // per-user ownership — the whole team maintains one board.
    match /Kanban/{taskId} {
      allow read, create, update, delete: if isApproved() || isAdmin();
    }

    // ---- docComments -------------------------------------------------------
    // Anchored review comments on the living Markdown documents (/docs/:slug).
    // The documents themselves are public engineering references, so their
    // review threads are readable by anyone — including signed-out visitors —
    // while authoring is restricted to approved members acting as themselves.
    match /docComments/{commentId} {
      allow read: if true;

      allow create: if (isApproved() || isAdmin())
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.documentId is string
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 5000;

      // Edit / resolve / reopen: the comment's author, or the admin.
      // Authorship can never be reassigned.
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.authorUid == request.auth.uid
            && request.resource.data.authorUid == resource.data.authorUid);

      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.authorUid == request.auth.uid);
    }

    // ---- Deny everything else ----------------------------------------------
    // Member collections (equipment, boards, lessons, ...) will be added here
    // guarded by isApproved()/isAdmin() as those features are built.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
